# AhsenDS - copia questo file in .env.local e compila solo i servizi che usi
# Supabase (catalogo, ordini, fornitori, coda ads, storico prezzi). Gratis su supabase.com
# Senza queste chiavi le pagine mostrano lo stato vuoto (nessun dato demo).
# URL + anon key: obbligatorie per login, catalogo e ordini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: opzionale, solo per automazioni server-side senza sessione (monitor, autopilot).
SUPABASE_SERVICE_ROLE_KEY=

# AI testi: descrizioni, caption, ads, siti web, ebook SCRITTI dall'AI (non template)
# La catena prova in ordine: Groq -> OpenRouter -> Gemini. Basta UNA chiave per partire.
# Groq (consigliato, gratis e veloce, GPT-OSS 120B): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (modelli potenti gratuiti, limiti ampi): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Gemini (fallback, gratis, Gemini 3.8 Flash): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CJ Dropshipping (prodotti reali + import). Account gratuito su cjdropshipping.com
# Trova la API Key in: My CJ > Authorization > API
CJ_EMAIL=
CJ_API_KEY=
# Alternativa: se hai gia un access token CJ valido, mettilo qui
CJ_ACCESS_TOKEN=

# AI / Hugging Face per la generazione di immagini e fotogrammi ads (opzionale)
# Crea un token gratuito su https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B

# TikTok Content Posting API (pubblicazione automatica dei video)
# Richiede un'app approvata su developers.tiktok.com con scope video.publish
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3 (upload automatico video/Shorts)
# Richiede un progetto Google Cloud con la API attiva e OAuth scope youtube.upload
YOUTUBE_ACCESS_TOKEN=

# Instagram Graph API (pubblicazione Reels/post)
# Account Instagram Business/Creator collegato a una Pagina Facebook.
# Doc: https://developers.facebook.com/docs/instagram-api/guides/content-publishing
IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Facebook Pages API (pubblicazione post e video sulla tua Pagina)
# Crea un'app su developers.facebook.com, collega la Pagina e genera un Page Access Token long-lived.
# Doc: https://developers.facebook.com/docs/pages-api/posts
FB_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Notifiche email del modulo contatti (SendGrid)
# Crea una API key con permesso Mail Send e verifica un Single Sender in SendGrid.
# Non serve un dominio custom: va verificato l'indirizzo usato come CONTACT_NOTIFY_FROM.
SENDGRID_API_KEY=
CONTACT_NOTIFY_TO=ahsenkurtoski@financier.com
CONTACT_NOTIFY_FROM=ahsenkurtoski@financier.com
CONTACT_NOTIFY_FROM_NAME=AhsenDS

# Segreto per il cron job di Vercel (protezione endpoint /api/monitor)
# Genera una stringa casuale sicura, es: openssl rand -hex 32
# Imposta lo stesso valore in Vercel Dashboard > Settings > Environment Variables
CRON_SECRET=
