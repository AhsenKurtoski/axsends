# Supabase (opzionale: l'app funziona con dati demo anche senza questi valori)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fornitore (es. CJ Dropshipping) per l'import reale
CJ_ACCESS_TOKEN=

# AI / Hugging Face per la generazione di video ads (opzionale)
# Crea un token gratuito su https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B
