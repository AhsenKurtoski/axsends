# AhsenDS - copia questo file in .env.local e compila solo i servizi che usi
# Supabase (catalogo, ordini, fornitori, coda ads, storico prezzi). Gratis su supabase.com
# Senza queste chiavi le pagine mostrano lo stato vuoto (nessun dato demo).
# URL + anon key: obbligatorie per login, catalogo e ordini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: opzionale, solo per automazioni server-side senza sessione (monitor, autopilot).
SUPABASE_SERVICE_ROLE_KEY=

# AI testi: descrizioni, caption, ads, siti web, ebook SCRITTI dall'AI (non template)
# La catena prova in ordine: Groq -> OpenRouter -> Gemini. Basta UNA chiave per partire.
# Groq (consigliato, gratis e veloce, GPT-OSS 120B): https://console.groq.com/keys
GROQ_API_KEY=
# Seconda chiave Groq: quando la prima finisce il limite giornaliero, l'app passa
# automaticamente a questa. Nessuna interruzione, nessun intervento manuale.
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (modelli potenti gratuiti, limiti ampi): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Gemini (fallback, gratis): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Seconda chiave Gemini: stessa logica di fallback di Groq.
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.8-flash

# CJ Dropshipping (prodotti reali + import). Account gratuito su cjdropshipping.com
# Trova la API Key in: My CJ > Authorization > API
CJ_EMAIL=
CJ_API_KEY=
# Alternativa: se hai gia un access token CJ valido, mettilo qui
CJ_ACCESS_TOKEN=

# IMMAGINI AI (ads, creativita, fotogrammi): gratis, senza chiave e senza carta.
# Il provider primario e' Pollinations (image.pollinations.ai); Hugging Face resta
# solo come riserva opzionale per chi ha un piano PRO.
HUGGINGFACE_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Pollinations gratis permette 1 immagine ogni 45s per IP: il codice mette le
# richieste in fila e le distanzia da solo. Con una pollen key (gratuita su
# enter.pollinations.ai) il limite sparisce: incollala qui se ce l'hai.
POLLINATIONS_TOKEN=
# Millisecondi minimi tra due immagini senza token (default 45500).
POLLINATIONS_MIN_INTERVAL_MS=45500

# VOCE delle ads (voiceover TTS nel video esportato).
# Il provider e' sostituibile: senza configurazione si usa l'endpoint pubblico di
# Google Translate, che non chiede chiavi. Le variabili qui sotto servono solo se
# vuoi un'altra voce (o se Google smette di funzionare).
# auto = primo provider configurato, google = senza chiave, oppure elevenlabs/openai/custom
TTS_PROVIDER=auto
# 0 = usa solo il provider scelto, senza passare agli altri in caso di errore.
TTS_FALLBACK=1
# Lingua della voce (it, en, es, fr, de, ...).
TTS_LANG=it
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI (o endpoint compatibile con /audio/speech). OPENAI_API_KEY e' anche la
# chiave usata dagli altri template AI, se e' gia' impostata qui non serve altro.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Endpoint tuo: usa {text} e {lang} come segnaposto, risposta audio/* (mp3, wav, ogg).
# TTS_CUSTOM_URL=https://voce.example.com/speak?text={text}&lang={lang}
TTS_CUSTOM_URL=
TTS_CUSTOM_API_KEY=

# VIDEO AI (mp4 verticale delle ads): gratis, senza carta.
# Hugging Face Spaces con ZeroGPU: 5 minuti di GPU al giorno per account gratuito.
# Wan 2.2 I2V anima il fotogramma generato dall'AI. Metti "off" per disattivarlo.
HF_VIDEO_SPACE=prithivmlmods/Wan2.2-Fast

# TikTok Content Posting API (pubblicazione automatica dei video)
# Richiede un'app approvata su developers.tiktok.com con scope video.publish
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3 (upload automatico video/Shorts)
# Richiede un progetto Google Cloud con la API attiva e OAuth scope youtube.upload
YOUTUBE_ACCESS_TOKEN=

# Instagram Graph API (pubblicazione Reels/post)
# Account Instagram Business/Creator collegato a una Pagina Facebook.
# Doc: https://developers.facebook.com/docs/instagram-api/guides/content-publishing
IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Facebook Pages API (pubblicazione post e video sulla tua Pagina)
# Crea un'app su developers.facebook.com, collega la Pagina e genera un Page Access Token long-lived.
# Doc: https://developers.facebook.com/docs/pages-api/posts
FB_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Notifiche email del modulo contatti (SendGrid)
# Crea una API key con permesso Mail Send e verifica un Single Sender in SendGrid.
# Non serve un dominio custom: va verificato l'indirizzo usato come CONTACT_NOTIFY_FROM.
SENDGRID_API_KEY=
CONTACT_NOTIFY_TO=ahsenkurtoski@financier.com
CONTACT_NOTIFY_FROM=ahsenkurtoski@financier.com
CONTACT_NOTIFY_FROM_NAME=AhsenDS

# Segreto per il cron job di Vercel (protezione endpoint /api/monitor)
# Genera una stringa casuale sicura, es: openssl rand -hex 32
# Imposta lo stesso valore in Vercel Dashboard > Settings > Environment Variables
CRON_SECRET=
